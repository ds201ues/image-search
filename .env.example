OPENAI_API_KEY=
VLM_MODEL=gpt-6-luna
# USD per 1M tokens, used only for cost reporting
VLM_PRICE_IN=0.10
VLM_PRICE_OUT=0.50
DATABASE_URL=postgresql://imgsearch:imgsearch@localhost:5433/imgsearch
# low | medium | high, or empty to omit
VLM_REASONING=low
# low | high | auto
VLM_DETAIL=auto

# stage 2 relevance backend: minilm (local cross-encoder) | jev (TypeSafe decision model, needs JEV_API_KEY)
RERANK_BACKEND=jev
JEV_API_KEY=
JEV_BATCH=50
JEV_BUDGET_USD=2.0
# LLM query understanding (cached per query); 0 = plain query
QUERY_PARSE=1
